#!/bin/sh
# Auto-bumps the patch version in pyproject.toml on every commit, unless
# the commit already touches the version line itself (manual major/minor
# bumps aren't overridden). Installed via:
#   git config core.hooksPath scripts

set -e

PYPROJECT="pyproject.toml"
NPM_LAUNCHER="packaging/npm/launcher/package.json"

current=$(grep -m1 '^version = ' "$PYPROJECT" | sed -E 's/version = "([0-9]+)\.([0-9]+)\.([0-9]+)"/\1.\2.\3/')

if git diff --cached -- "$PYPROJECT" | grep -q '^[+-]version = '; then
    # Manual bump: keep the version the commit sets, but still carry it
    # over to the npm launcher so the two never drift.
    next="$current"
else
    major=$(echo "$current" | cut -d. -f1)
    minor=$(echo "$current" | cut -d. -f2)
    patch=$(echo "$current" | cut -d. -f3)
    next="$major.$minor.$((patch + 1))"

    sed -E "s/^version = \"$current\"/version = \"$next\"/" "$PYPROJECT" > "$PYPROJECT.tmp"
    mv "$PYPROJECT.tmp" "$PYPROJECT"
    git add "$PYPROJECT"
fi

if [ -f "$NPM_LAUNCHER" ]; then
    # Keep the launcher "version" AND every "@omm-hippo/omm-<platform>" optional
    # dependency equal to $next. npm_package.py validate requires them equal; the
    # old hook rewrote only the top-level version line, so a commit that didn't
    # touch it left the two drifted (version 0.3.51 / deps 0.3.50).
    sed -E \
        -e "s/\"version\": \"[0-9]+\.[0-9]+\.[0-9]+\"/\"version\": \"$next\"/" \
        -e "s/(\"@omm-hippo\/omm-[a-z0-9-]+\": \")[0-9]+\.[0-9]+\.[0-9]+\"/\1$next\"/" \
        "$NPM_LAUNCHER" > "$NPM_LAUNCHER.tmp"
    if cmp -s "$NPM_LAUNCHER" "$NPM_LAUNCHER.tmp"; then
        rm -f "$NPM_LAUNCHER.tmp"
    else
        mv "$NPM_LAUNCHER.tmp" "$NPM_LAUNCHER"
        git add "$NPM_LAUNCHER"
    fi
fi
